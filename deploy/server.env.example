# Settings for the always-on server that runs the API and the workers (copy to .env on the server, then fill in).
# Never commit the filled-in file. Do not paste real values into chats.

# --- Database (Supabase): the same project your data lives in. Use the "Session pooler" address (port 5432).
DATABASE_URL=

# --- Queue (Redis). On your own server, run Redis there (free): redis://localhost:6379
REDIS_URL=redis://localhost:6379

# --- Secrets: copy these two from your computer's .env so existing mailbox logins and sessions keep working.
CREDENTIALS_KEY=
SESSION_SECRET=

# --- The app's own emails (sign-up codes). Format: smtps://EMAIL-with-%40:APP-PASSWORD@SERVER:465
SYSTEM_SMTP_URL=
SYSTEM_MAIL_FROM=

# --- Addresses. With the website on Vercel, all three are usually the same Vercel address, because Vercel forwards
#     /v1, /t and /u to this server (see apps/web/vercel.json).
WEB_ORIGIN=https://YOUR-SITE
PUBLIC_URL=https://YOUR-SITE
TRACKING_BASE_URL=https://YOUR-SITE

API_PORT=4000
NODE_ENV=production

# --- Google / Microsoft sign-in (only if you use the "Connect with Google/Microsoft" buttons)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

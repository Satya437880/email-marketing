{
  "name": "outreach",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web",
    "db:generate": "npm run generate -w @outreach/db",
    "db:migrate": "npm run migrate -w @outreach/db",
    "dev:api": "npm run dev -w @outreach/api",
    "dev:workers": "npm run dev -w @outreach/workers",
    "dev:web": "npm run dev -w @outreach/web",
    "start:workers": "node worker.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

DATABASE_URL=postgres://postgres:postgres@localhost:5432/outreach
REDIS_URL=redis://localhost:6379
# 32-byte hex key used to encrypt mailbox credentials (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
CREDENTIALS_KEY=
SESSION_SECRET=
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
TRACKING_BASE_URL=http://localhost:4000
# ---------------------------------------------------------------------------------------------
# GOOGLE / MICROSOFT LOGIN  <-- the Client IDs go here
# Enables two things: "Login with Google/Microsoft" on the login page, and one-click mailbox
# connect (Gmail / Outlook). Each button only appears once its Client ID and Secret are filled in.
# After editing this file, restart the API.
# ---------------------------------------------------------------------------------------------
# Public address of the web app. Redirect URIs below are built from it.
PUBLIC_URL=http://localhost:5173

# GOOGLE CLIENT ID: Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorised redirect URIs to add (replace the host with PUBLIC_URL when you deploy):
#   http://localhost:5173/v1/auth/oauth/google/callback   (login page)
#   http://localhost:5173/v1/oauth/google/callback        (connect a Gmail mailbox)
# OAuth consent screen: add the scope https://mail.google.com/ (mailbox connect only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MICROSOFT CLIENT ID: Azure portal -> Microsoft Entra ID -> App registrations -> New registration (platform: Web).
# Redirect URIs to add:
#   http://localhost:5173/v1/auth/oauth/microsoft/callback   (login page)
#   http://localhost:5173/v1/oauth/microsoft/callback        (connect an Outlook mailbox)
# API permissions (Delegated): openid, email, profile, offline_access, IMAP.AccessAsUser.All, SMTP.Send
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Leave as 'common' to allow any Microsoft account, or put your Directory (tenant) ID to allow only your organisation.
MICROSOFT_TENANT=common
